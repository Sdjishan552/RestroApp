<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome_gradient">

    <!-- Stars/particle decoration -->
    <View
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginTop="60dp"
        android:layout_marginStart="40dp"
        android:background="@color/white"
        android:alpha="0.6"
        android:id="@+id/star1"/>
    <View
        android:layout_width="3dp"
        android:layout_height="3dp"
        android:layout_marginTop="120dp"
        android:layout_marginStart="280dp"
        android:background="@color/white"
        android:alpha="0.5"
        android:id="@+id/star2"/>
    <View
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_marginTop="200dp"
        android:layout_marginStart="80dp"
        android:background="@color/white"
        android:alpha="0.4"
        android:id="@+id/star3"/>

    <!-- Center content -->
    <LinearLayout
        android:id="@+id/centerContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginBottom="200dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_logo"
            android:contentDescription="BizManager Logo"/>

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="BizManager"
            android:textColor="@color/white"
            android:textSize="40sp"
            android:letterSpacing="0.05"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/welcome_tagline"
            android:textColor="#B0BEC5"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"/>
    </LinearLayout>

    <!-- Bottom Card with Buttons -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="0dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="24dp"
        app:cardBackgroundColor="@color/surface"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Get Started"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Are you an owner or employee?"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="28dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateCompany"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="@string/btn_create_company"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:backgroundTint="#6C63FF"
                app:cornerRadius="16dp"
                android:layout_marginBottom="14dp"
                style="@style/Widget.MaterialComponents.Button"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnJoinCompany"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="@string/btn_join_company"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#6C63FF"
                app:backgroundTint="#F0F2FF"
                app:strokeColor="#6C63FF"
                app:strokeWidth="2dp"
                app:cornerRadius="16dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:text="@string/welcome_version"
                android:textSize="12sp"
                android:textColor="@color/text_hint"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>
