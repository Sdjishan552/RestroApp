<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="220dp" android:background="@drawable/bg_header_gradient" android:gravity="bottom" android:orientation="vertical" android:padding="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <de.hdodenhof.circleimageview.CircleImageView android:id="@+id/ivAvatar" android:layout_width="54dp" android:layout_height="54dp" android:src="@drawable/ic_logo" app:civ_border_color="#50FFFFFF" app:civ_border_width="2dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tvWelcome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hello, Employee" android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvCompanyName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Company" android:textColor="#D9E2FF" android:textSize="14sp"/>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnLogout" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="@string/logout" android:textColor="@color/white" app:icon="@android:drawable/ic_lock_power_off" app:iconTint="@color/white"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="Your Workspace" android:textColor="@color/white" android:textSize="28sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Only admin-approved modules are shown" android:textColor="#D9E2FF" android:textSize="14sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/tvNoAccess" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_stat_card" android:gravity="center" android:padding="18dp" android:text="No modules are enabled for your account yet. Contact your admin." android:textColor="@color/text_secondary" android:textSize="14sp" android:visibility="gone"/>
            <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2">
                <include android:id="@+id/cardStock" layout="@layout/card_module_stock"/>
                <include android:id="@+id/cardOrders" layout="@layout/card_module_orders"/>
                <include android:id="@+id/cardFinance" layout="@layout/card_module_finance"/>
                <include android:id="@+id/cardProducts" layout="@layout/card_module_products"/>
                <include android:id="@+id/cardReports" layout="@layout/card_module_reports"/>
            </GridLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
