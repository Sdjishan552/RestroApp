<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BizManager" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowTranslucentStatus">false</item>
    </style>

    <style name="Theme.BizManager.Splash" parent="Theme.BizManager">
        <item name="android:windowBackground">@drawable/bg_splash</item>
    </style>

    <!-- Toolbar style -->
    <style name="BizToolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/primary</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/primary_light</item>
    </style>

    <!-- FAB style -->
    <style name="BizFAB" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/accent</item>
        <item name="tint">@color/black</item>
    </style>

    <!-- Card style -->
    <style name="DashCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">6dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Dialog style -->
    <style name="BizDialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="cornerRadius">20dp</item>
    </style>
</resources>
